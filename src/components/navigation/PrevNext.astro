---
import type { CollectionEntry } from 'astro:content';
import { ui } from '@/i18n/ui';

interface Props {
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { prev, next } = Astro.props;

const baseUrl = import.meta.env.BASE_URL || '/';
---

{(prev || next) && (
  <nav class="post-prev-next">
    {prev && (
      <a href={`${baseUrl}blog/${prev.slug}`} class="post-prev-next-link is-prev">
        <span class="post-prev-next-label">
          <span class="i18n-en">{ui.en.previous}</span>
          <span class="i18n-zh">{ui.zh.previous}</span>
        </span>
        <span class="post-prev-next-title">
          <span class="i18n-en">{prev.data.title}</span>
          <span class="i18n-zh">{prev.data.titleZh}</span>
        </span>
      </a>
    )}
    {!prev && <div class="post-prev-next-spacer" />}

    {next && (
      <a href={`${baseUrl}blog/${next.slug}`} class="post-prev-next-link is-next">
        <span class="post-prev-next-label">
          <span class="i18n-en">{ui.en.next}</span>
          <span class="i18n-zh">{ui.zh.next}</span>
        </span>
        <span class="post-prev-next-title">
          <span class="i18n-en">{next.data.title}</span>
          <span class="i18n-zh">{next.data.titleZh}</span>
        </span>
      </a>
    )}
    {!next && <div class="post-prev-next-spacer" />}
  </nav>
)}
