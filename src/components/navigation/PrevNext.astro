---
import type { CollectionEntry } from 'astro:content';

interface Props {
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { prev, next } = Astro.props;

const baseUrl = import.meta.env.BASE_URL || '/';
---

{(prev || next) && (
  <nav class="post-prev-next">
    {prev && (
      <a href={`${baseUrl}blog/${prev.slug}`} class="post-prev-next-link is-prev">
        <span class="post-prev-next-label">
          <span class="i18n-en">Previous</span>
          <span class="i18n-zh">上一篇</span>
        </span>
        <span class="post-prev-next-title">{prev.data.title}</span>
      </a>
    )}
    {!prev && <div class="post-prev-next-spacer" />}

    {next && (
      <a href={`${baseUrl}blog/${next.slug}`} class="post-prev-next-link is-next">
        <span class="post-prev-next-label">
          <span class="i18n-en">Next</span>
          <span class="i18n-zh">下一篇</span>
        </span>
        <span class="post-prev-next-title">{next.data.title}</span>
      </a>
    )}
    {!next && <div class="post-prev-next-spacer" />}
  </nav>
)}
