---
import { siteConfig } from '@/site.config';

const baseUrl = import.meta.env.BASE_URL || '/';
const currentYear = new Date().getFullYear();

const footerLinks = [
  { href: `${baseUrl}projects`, labelEn: 'Projects', labelZh: '项目' },
  { href: `${baseUrl}blog`, labelEn: 'Notes', labelZh: '笔记' },
  { href: `${baseUrl}about`, labelEn: 'About', labelZh: '关于' },
  { href: `${baseUrl}rss.xml`, labelEn: 'RSS', labelZh: 'RSS' },
];
---

<footer class="border-t border-notion-border dark:border-notion-border-dark">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <div>
        <p class="text-sm font-semibold tracking-tight text-notion-text dark:text-notion-text-dark mb-2">
          {siteConfig.author}
        </p>
        <p class="text-sm leading-relaxed text-notion-text/65 dark:text-notion-text-dark/55 max-w-xs">
          <span class="i18n-en">{siteConfig.description}</span>
          <span class="i18n-zh">{siteConfig.descriptionZh}</span>
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-notion-text/50 dark:text-notion-text-dark/45 mb-4">
          <span class="i18n-en">Site</span>
          <span class="i18n-zh">本站</span>
        </h3>
        <ul class="space-y-2">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-notion-text/70 dark:text-notion-text-dark/60 hover:text-notion-blue transition-colors"
              >
                <span class="i18n-en">{link.labelEn}</span>
                <span class="i18n-zh">{link.labelZh}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-notion-text/50 dark:text-notion-text-dark/45 mb-4">
          <span class="i18n-en">Connect</span>
          <span class="i18n-zh">联系</span>
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={siteConfig.social.github} class="text-notion-text/70 dark:text-notion-text-dark/60 hover:text-notion-blue transition-colors">
              GitHub
            </a>
          </li>
          <li>
            <a href={siteConfig.social.x} class="text-notion-text/70 dark:text-notion-text-dark/60 hover:text-notion-blue transition-colors">
              X / @JoeCheungZzz
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.email}`} class="text-notion-text/70 dark:text-notion-text-dark/60 hover:text-notion-blue transition-colors">
              {siteConfig.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-notion-border dark:border-notion-border-dark text-xs text-notion-text/45 dark:text-notion-text-dark/40">
      © {currentYear} {siteConfig.author}
    </div>
  </div>
</footer>
