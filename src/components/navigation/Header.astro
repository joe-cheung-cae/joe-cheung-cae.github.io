---
import ThemeToggle from '../ThemeToggle';
import LangToggle from '../LangToggle';
import { siteConfig } from '@/site.config';

const baseUrl = import.meta.env.BASE_URL || '/';

const navLinks = [
  { href: baseUrl, labelEn: 'Home', labelZh: '主页' },
  { href: `${baseUrl}projects`, labelEn: 'Projects', labelZh: '项目' },
  { href: `${baseUrl}blog`, labelEn: 'Notes', labelZh: '笔记' },
  { href: `${baseUrl}about`, labelEn: 'About', labelZh: '关于' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-notion-bg/80 dark:bg-notion-bg-dark/80 backdrop-blur-md border-b border-notion-border dark:border-notion-border-dark">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={baseUrl} class="flex items-center gap-2.5 text-notion-text dark:text-notion-text-dark hover:text-notion-blue transition-colors">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-notion-border dark:border-notion-border-dark font-mono text-[11px] font-semibold tracking-tight">
          {siteConfig.shortName}
        </span>
        <span class="text-sm font-semibold tracking-tight">{siteConfig.author}</span>
      </a>

      <nav class="hidden md:flex items-center gap-7">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors ${
              currentPath === link.href || (link.href !== baseUrl && currentPath.startsWith(link.href))
                ? 'text-notion-blue'
                : 'text-notion-text dark:text-notion-text-dark hover:text-notion-blue'
            }`}
          >
            <span class="i18n-en">{link.labelEn}</span>
            <span class="i18n-zh">{link.labelZh}</span>
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-1">
        <button
          type="button"
          id="search-trigger"
          class="flex items-center gap-2 min-h-11 px-3 rounded-md text-sm text-notion-text dark:text-notion-text-dark/70 hover:bg-notion-gray dark:hover:bg-notion-gray-dark transition-colors"
          aria-label="Open search"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <kbd class="hidden md:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono bg-notion-gray dark:bg-notion-gray-dark rounded">
            ⌘K
          </kbd>
        </button>

        <LangToggle client:only="preact" transition:persist="lang-toggle" />
        <ThemeToggle client:only="preact" transition:persist="theme-toggle" />

        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden min-h-11 min-w-11 inline-flex items-center justify-center rounded-md text-notion-text dark:text-notion-text-dark hover:bg-notion-gray dark:hover:bg-notion-gray-dark"
          aria-label="Toggle menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <nav id="mobile-menu" class="hidden md:hidden py-3 border-t border-notion-border dark:border-notion-border-dark">
      <div class="flex flex-col gap-1 pb-3">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-2.5 rounded-md text-sm font-medium transition-colors ${
              currentPath === link.href || (link.href !== baseUrl && currentPath.startsWith(link.href))
                ? 'bg-notion-blue-light dark:bg-blue-900/30 text-notion-blue'
                : 'text-notion-text dark:text-notion-text-dark hover:bg-notion-gray dark:hover:bg-notion-gray-dark'
            }`}
          >
            <span class="i18n-en">{link.labelEn}</span>
            <span class="i18n-zh">{link.labelZh}</span>
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

