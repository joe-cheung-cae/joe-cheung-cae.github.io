---
import type { CollectionEntry } from 'astro:content';
import { ui } from '@/i18n/ui';
import NoteCard from './notes/NoteCard.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="related-posts">
    <h2>
      <span class="i18n-en">{ui.en.relatedNotes}</span>
      <span class="i18n-zh">{ui.zh.relatedNotes}</span>
    </h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <NoteCard post={post} />
        </li>
      ))}
    </ul>
  </section>
)}
