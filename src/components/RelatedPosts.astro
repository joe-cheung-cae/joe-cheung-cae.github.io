---
import type { CollectionEntry } from 'astro:content';
import NoteCard from './notes/NoteCard.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="related-posts">
    <h2>
      <span class="i18n-en">Related notes</span>
      <span class="i18n-zh">相关笔记</span>
    </h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <NoteCard post={post} />
        </li>
      ))}
    </ul>
  </section>
)}
