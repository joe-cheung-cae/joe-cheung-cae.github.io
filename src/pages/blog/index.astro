---
import NotesLayout from '@/layouts/NotesLayout.astro';
import NoteCard from '@/components/notes/NoteCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/site.config';

const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) =>
  b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const pageSize = siteConfig.pagination.postsPerPage;
const posts = sortedPosts;
---

<NotesLayout
  title="Notes"
  description="Technical notes on C++, CUDA, CMake, and computational geometry"
  banner="index"
  bannerTitleEn="Notes"
  bannerTitleZh="笔记"
  bannerSubtitleEn={`${sortedPosts.length} notes on C++, CUDA, CMake, and computational geometry`}
  bannerSubtitleZh={`${sortedPosts.length} 篇笔记，关于 C++、CUDA、CMake 与计算几何`}
>
  <ul class="post-list" data-page-size={pageSize}>
    {posts.map((post) => (
      <li>
        <NoteCard post={post} />
      </li>
    ))}
  </ul>
</NotesLayout>
