---
import NotesLayout from '@/layouts/NotesLayout.astro';
import { siteConfig } from '@/site.config';
import { projects } from '@/data/projects';
import { ui } from '@/i18n/ui';
---

<NotesLayout
  title="Projects"
  description="Public CAE, HPC, and GPU projects by Joe Cheung"
  banner="index"
  bannerTitleEn="Projects"
  bannerTitleZh="项目"
  bannerSubtitleEn="Reusable pieces around particle solvers. Client studies and production engines are not listed."
  bannerSubtitleZh="粒子求解器周边的可复用件。客户算例与生产引擎不在此列出。"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {projects.map((project) => (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group block p-6 rounded-xl border border-notion-border dark:border-notion-border-dark bg-notion-bg dark:bg-notion-bg-dark hover:border-notion-blue transition-colors"
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <h2 class="text-xl font-semibold text-notion-text dark:text-notion-text-dark group-hover:text-notion-blue transition-colors">
              {project.name}
            </h2>
            <span class="text-xs font-mono text-notion-text/45 dark:text-notion-text-dark/40">↗</span>
          </div>
          <p class="text-sm leading-relaxed text-notion-text/70 dark:text-notion-text-dark/65 mb-4">
            <span class="i18n-en">{project.blurbEn}</span>
            <span class="i18n-zh">{project.blurbZh}</span>
          </p>
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded text-xs font-mono bg-notion-gray dark:bg-notion-gray-dark text-notion-text/70 dark:text-notion-text-dark/65">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center min-h-11 px-5 rounded-md border border-notion-border dark:border-notion-border-dark text-sm font-medium text-notion-text dark:text-notion-text-dark hover:border-notion-blue transition-colors"
      >
        <span class="i18n-en">{ui.en.githubProfile}</span>
        <span class="i18n-zh">{ui.zh.githubProfile}</span>
      </a>
    </div>
  </div>
</NotesLayout>
