---
import NotesLayout from '@/layouts/NotesLayout.astro';
---

<NotesLayout
  title="Search"
  description="Search all technical notes"
  banner="index"
  bannerTitleEn="Search"
  bannerTitleZh="搜索"
  bannerSubtitleEn="Find notes by title, content, tags, or programming language"
  bannerSubtitleZh="按标题、正文、标签或编程语言查找笔记"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mt-4 max-w-2xl mx-auto">
      <h2 class="text-lg font-semibold text-notion-text dark:text-notion-text-dark mb-4">
        <span class="i18n-en">Search Tips</span>
        <span class="i18n-zh">搜索提示</span>
      </h2>
      <ul class="space-y-2 text-notion-text dark:text-notion-text-dark/70">
        <li class="flex items-start gap-2">
          <span class="text-notion-blue">•</span>
          <span class="i18n-en">
            Press <kbd class="px-2 py-0.5 bg-notion-gray dark:bg-notion-gray-dark rounded text-sm font-mono">Cmd+K</kbd> (or <kbd class="px-2 py-0.5 bg-notion-gray dark:bg-notion-gray-dark rounded text-sm font-mono">Ctrl+K</kbd>) from any page to open search
          </span>
          <span class="i18n-zh">
            在任意页面按 <kbd class="px-2 py-0.5 bg-notion-gray dark:bg-notion-gray-dark rounded text-sm font-mono">Cmd+K</kbd>（或 <kbd class="px-2 py-0.5 bg-notion-gray dark:bg-notion-gray-dark rounded text-sm font-mono">Ctrl+K</kbd>）打开搜索
          </span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-notion-blue">•</span>
          <span class="i18n-en">Search by programming language (e.g., "C++", "CUDA")</span>
          <span class="i18n-zh">按编程语言搜索（例如 “C++”、“CUDA”）</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-notion-blue">•</span>
          <span class="i18n-en">Search by tags (e.g., "algorithms", "memory-management")</span>
          <span class="i18n-zh">按标签搜索（例如 “algorithms”、“memory-management”）</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-notion-blue">•</span>
          <span class="i18n-en">Results are ranked by relevance to your query</span>
          <span class="i18n-zh">结果按与查询的相关度排序</span>
        </li>
      </ul>
    </div>

    <div class="mt-12 max-w-2xl mx-auto">
      <h2 class="text-lg font-semibold text-notion-text dark:text-notion-text-dark mb-4">
        <span class="i18n-en">Popular Topics</span>
        <span class="i18n-zh">热门主题</span>
      </h2>
      <div class="flex flex-wrap gap-3">
        {['C++', 'CUDA', 'CMake', 'Algorithms', 'Smart Pointers', 'Move Semantics'].map((topic) => (
          <button
            type="button"
            class="popular-search-btn px-4 py-2 rounded-full bg-notion-gray dark:bg-notion-gray-dark text-notion-text dark:text-notion-text-dark hover:bg-notion-border dark:hover:bg-notion-border-dark transition-colors"
            data-query={topic}
          >
            {topic}
          </button>
        ))}
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.popular-search-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const query = btn.getAttribute('data-query');
        window.dispatchEvent(new CustomEvent('open-search', { detail: { query } }));
      });
    });
  </script>
</NotesLayout>
