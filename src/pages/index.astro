---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/navigation/Footer.astro';
import Card from '@/components/ui/Card.astro';
import SearchModal from '@/components/search/SearchModal';
import FluidBackground from '@/components/homepage/FluidBackground';
import HomepageChrome from '@/components/homepage/HomepageChrome.astro';
import IntroMotion from '@/components/homepage/IntroMotion';
import { getCollection } from 'astro:content';
import { homepageConfig } from '@/homepage.config';
import { featuredProjects } from '@/data/projects';
import { homepageNotesFontFaceCss, homepageNotesInlineStyle } from '@/lib/homepage-notes-font';
import { ui } from '@/i18n/ui';
import '@/styles/homepage.css';

const backgroundEnabled = homepageConfig.intro.background;
const { intro, main } = homepageConfig;

const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const featuredPosts = sortedPosts.filter((post) => post.data.featured).slice(0, 2);
const latestPosts = sortedPosts.filter((post) => !post.data.featured).slice(0, 3);

const searchIndex = allPosts.map((post) => ({
  id: post.slug,
  title: post.data.title,
  titleZh: post.data.titleZh,
  description: post.data.description,
  descriptionZh: post.data.descriptionZh,
  content: post.body?.slice(0, 2000) || '',
  slug: post.slug,
  tags: post.data.tags,
  language: post.data.language,
}));

const shapePath =
  'M -44,-50 C -52.71,28.52 15.86,8.186 184,14.69 383.3,22.39 462.5,12.58 638,14 835.5,15.6 987,6.4 1194,13.86 1661,30.68 1652,-36.74 1582,-140.1 1512,-243.5 15.88,-589.5 -44,-50 Z';
const shapePathTo =
  'M -44,-50 C -137.1,117.4 67.86,445.5 236,452 435.3,459.7 500.5,242.6 676,244 873.5,245.6 957,522.4 1154,594 1593,753.7 1793,226.3 1582,-126 1371,-478.3 219.8,-524.2 -44,-50 Z';
---

<BaseLayout title={homepageConfig.head.title} description={homepageConfig.head.description}>
  <div
    id="homepage"
    class="homepage-root flex-1"
    data-page-transition="intro"
    data-fluid-background={backgroundEnabled ? 'on' : 'off'}
  >
    <noscript>
      <style>
        .homepage-intro { display: none !important; }
        .homepage-root { height: auto !important; overflow: visible !important; }
      </style>
    </noscript>

    <Fragment set:html={`<style data-homepage-notes-font>${homepageNotesFontFaceCss()}</style>`} />
    <HomepageChrome />
    {backgroundEnabled && <FluidBackground client:load backgroundEnabled />}
    <IntroMotion client:load />

    <section class="homepage-intro">
      <script is:inline data-astro-rerun>
        (function () {
          var root = document.getElementById('homepage');
          if (!root) return;
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          root.setAttribute('data-page-transition', reduce ? 'main' : 'intro');
          var enabled = root.getAttribute('data-fluid-background') === 'on';
          var on = enabled && !reduce;
          root.setAttribute('data-fluid-background', on ? 'on' : 'off');
          if (!on || document.getElementById('background')) return;
          var intro = root.querySelector('.homepage-intro') || root;
          var canvas = document.createElement('canvas');
          canvas.id = 'background';
          canvas.setAttribute('aria-hidden', 'true');
          intro.insertBefore(canvas, intro.firstChild);
        })();
      </script>
      <p class="sr-only">
        <span class="i18n-en">Intro</span>
        <span class="i18n-zh">开场</span>
      </p>
      <div class="homepage-intro-inner">
        <div class="homepage-wrap">
          <h1 class="homepage-intro-title">{intro.title}</h1>
          <p class="homepage-intro-subtitle">
            <span class="i18n-en">{intro.subtitle.en}</span>
            <span class="i18n-zh">{intro.subtitle.zh}</span>
          </p>
          <button type="button" class="homepage-enter" data-homepage-enter>
            <span class="i18n-en">{intro.enter.en}</span>
            <span class="i18n-zh">{intro.enter.zh}</span>
          </button>
        </div>
        <div class="homepage-arrows" aria-hidden="true">
          <button type="button" class="homepage-arrow homepage-arrow-1" data-homepage-enter tabindex="-1"></button>
          <button type="button" class="homepage-arrow homepage-arrow-2" data-homepage-enter tabindex="-1"></button>
        </div>
      </div>
      <div class="shape-wrap" aria-hidden="true">
        <svg
          class="shape"
          width="100%"
          height="100%"
          preserveAspectRatio="none"
          viewBox="0 0 1440 800"
        >
          <path d={shapePath} data-path-to={shapePathTo}></path>
        </svg>
      </div>
    </section>

    <div class="homepage-main">
      <section class="homepage-identity" id="card">
        <p class="sr-only">
          <span class="i18n-en">Identity</span>
          <span class="i18n-zh">名片</span>
        </p>
        <div class="homepage-card">
          <h1 class="homepage-card-name">{main.name}</h1>
          <p class="homepage-card-signature">
            <span class="i18n-en">{main.signature.en}</span>
            <span class="i18n-zh">{main.signature.zh}</span>
          </p>
          <nav class="homepage-card-nav">
            <span class="sr-only i18n-en">Primary</span>
            <span class="sr-only i18n-zh">主要</span>
            {main.links.map((link) => {
              const external = link.href.startsWith('http');
              return (
                <a
                  href={link.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <span class="i18n-en">{link.textEn}</span>
                  <span class="i18n-zh">{link.textZh}</span>
                </a>
              );
            })}
          </nav>
        </div>
      </section>

      <section class="py-16 sm:py-20 bg-notion-gray dark:bg-notion-gray-dark/30">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-end justify-between gap-4 mb-8">
            <div>
              <h2 class="text-2xl font-semibold text-notion-text dark:text-notion-text-dark">
                <span class="i18n-en">{ui.en.selectedWork}</span>
                <span class="i18n-zh">{ui.zh.selectedWork}</span>
              </h2>
              <p class="mt-1 text-sm text-notion-text/60 dark:text-notion-text-dark/55">
                <span class="i18n-en">Public repositories only. Production solvers stay private.</span>
                <span class="i18n-zh">仅列出公开仓库。生产求解器保持私有。</span>
              </p>
            </div>
            <a href="/projects" class="text-sm font-medium text-notion-blue hover:underline">
              <span class="i18n-en">{ui.en.allProjects}</span>
              <span class="i18n-zh">{ui.zh.allProjects}</span>
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {featuredProjects.map((project) => (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="group block p-6 rounded-xl border border-notion-border dark:border-notion-border-dark bg-notion-bg dark:bg-notion-bg-dark hover:border-notion-blue transition-colors"
              >
                <div class="flex items-start justify-between gap-3 mb-3">
                  <h3 class="text-lg font-semibold text-notion-text dark:text-notion-text-dark group-hover:text-notion-blue transition-colors">
                    {project.name}
                  </h3>
                  <span class="text-xs font-mono text-notion-text/45 dark:text-notion-text-dark/40">↗</span>
                </div>
                <p class="text-sm leading-relaxed text-notion-text/70 dark:text-notion-text-dark/65 mb-4">
                  <span class="i18n-en">{project.blurbEn}</span>
                  <span class="i18n-zh">{project.blurbZh}</span>
                </p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded text-xs font-mono bg-notion-gray dark:bg-notion-gray-dark text-notion-text/70 dark:text-notion-text-dark/65">
                      {tag}
                    </span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      {featuredPosts.length > 0 && (
        <section
          id="featured-notes"
          class="homepage-notes py-16 sm:py-20"
          style={homepageNotesInlineStyle()}
        >
          <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between mb-8">
              <div>
                <h2 class="text-2xl font-semibold text-notion-text dark:text-notion-text-dark">
                  <span class="i18n-en">{ui.en.startHere}</span>
                  <span class="i18n-zh">{ui.zh.startHere}</span>
                </h2>
                <p class="text-sm text-notion-text/60 dark:text-notion-text-dark/55 mt-1">
                  <span class="i18n-en">{ui.en.featuredNotes}</span>
                  <span class="i18n-zh">{ui.zh.featuredNotes}</span>
                </p>
              </div>
              <a href="/blog" class="text-sm font-medium text-notion-blue hover:underline">
                <span class="i18n-en">{ui.en.viewAllNotes}</span>
                <span class="i18n-zh">{ui.zh.viewAllNotes}</span>
              </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {featuredPosts.map((post) => (
                <Card post={post} featured />
              ))}
            </div>
          </div>
        </section>
      )}

      {latestPosts.length > 0 && (
        <section
          id="latest-notes"
          class="homepage-notes py-12 pb-20"
          style={homepageNotesInlineStyle()}
        >
          <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-semibold text-notion-text dark:text-notion-text-dark mb-8">
              <span class="i18n-en">{ui.en.latestNotes}</span>
              <span class="i18n-zh">{ui.zh.latestNotes}</span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {latestPosts.map((post) => (
                <Card post={post} />
              ))}
            </div>
          </div>
        </section>
      )}

      <Footer />
    </div>
  </div>
  <SearchModal client:idle searchIndex={searchIndex} transition:persist="search-modal" />
</BaseLayout>
