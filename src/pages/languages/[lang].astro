---
import NotesLayout from '@/layouts/NotesLayout.astro';
import NoteCard from '@/components/notes/NoteCard.astro';
import { getCollection } from 'astro:content';
import { ui } from '@/i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const languages = [...new Set(posts.map(post => post.data.language).filter(Boolean))];

  return languages.map(lang => ({
    params: { lang: lang?.toLowerCase().replace(/\s+/g, '-') },
    props: { language: lang },
  }));
}

const { language } = Astro.props;

const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const languagePosts = allPosts.filter(post => post.data.language === language);

const sortedPosts = languagePosts.sort((a, b) =>
  b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const relatedTagsMap = new Map<string, number>();
languagePosts.forEach(post => {
  post.data.tags.forEach(tag => {
    relatedTagsMap.set(tag, (relatedTagsMap.get(tag) || 0) + 1);
  });
});

const relatedTags = Array.from(relatedTagsMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 15)
  .map(([tag]) => tag);
---

<NotesLayout
  title={language || ''}
  description={`Notes about ${language}`}
  banner="index"
  bannerTitleEn={language || ''}
  bannerTitleZh={language || ''}
  bannerSubtitleEn={`${sortedPosts.length} ${sortedPosts.length === 1 ? 'note' : 'notes'} about ${language}`}
  bannerSubtitleZh={`${sortedPosts.length} 篇关于 ${language} 的笔记`}
>
  {relatedTags.length > 0 && (
    <div class="taxonomy-related">
      <h2>
        <span class="i18n-en">{ui.en.topicsHeading}</span>
        <span class="i18n-zh">{ui.zh.topicsHeading}</span>
      </h2>
      <div class="flex flex-wrap gap-2">
        {relatedTags.map(tag => (
          <a
            href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
            class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-notion-gray dark:bg-notion-gray-dark text-notion-text dark:text-notion-text-dark hover:bg-notion-border dark:hover:bg-notion-border-dark transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    </div>
  )}

  {sortedPosts.length > 0 ? (
    <ul class="post-list">
      {sortedPosts.map(post => (
        <li>
          <NoteCard post={post} />
        </li>
      ))}
    </ul>
  ) : (
    <div class="taxonomy-empty">
      <p class="i18n-en">{ui.en.noPostsLang}</p>
      <p class="i18n-zh">{ui.zh.noPostsLang}</p>
      <a href="/languages" class="inline-flex items-center mt-4 text-notion-blue hover:underline">
        <span class="i18n-en">{ui.en.browseAllLanguages}</span>
        <span class="i18n-zh">{ui.zh.browseAllLanguages}</span>
      </a>
    </div>
  )}
</NotesLayout>
