---
import NotesLayout from './NotesLayout.astro';
import TOC from '@/components/navigation/TOC.astro';
import PrevNext from '@/components/navigation/PrevNext.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import { formatWords, ui } from '@/i18n/ui';
import { formatDate } from '@/utils/formatDate';
import { formatReadingTime } from '@/utils/readingTime';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: Array<{ depth: number; slug: string; text: string }>;
  prevPost?: CollectionEntry<'posts'>;
  nextPost?: CollectionEntry<'posts'>;
  relatedPosts: CollectionEntry<'posts'>[];
  readingTime: number;
  wordCount: number;
}

const { post, headings, prevPost, nextPost, relatedPosts, readingTime, wordCount } = Astro.props;
const { title, titleZh, description, pubDate, updatedDate, tags, language } = post.data;
const showTOC = headings.length > 0;
const baseUrl = import.meta.env.BASE_URL || '/';
---

<NotesLayout
  title={title}
  description={description}
  ogImage={post.data.ogImage}
  canonicalUrl={post.data.canonicalUrl}
  banner="post"
  headerTitle={title}
  headerTitleEn={title}
  headerTitleZh={titleZh}
>
  <article class="post-article">
    <div class="post-card">
      <h1 class="post-card-title">
        <span class="i18n-en">{title}</span>
        <span class="i18n-zh">{titleZh}</span>
      </h1>

      <p class="post-card-meta">
        <time datetime={pubDate.toISOString()}>
          <span class="i18n-en">{formatDate(pubDate, 'en')}</span>
          <span class="i18n-zh">{formatDate(pubDate, 'zh')}</span>
        </time>
        {updatedDate && (
          <span class="post-updated">
            <span class="i18n-en">{ui.en.updated}</span>
            <span class="i18n-zh">{ui.zh.updated}</span>
            <time datetime={updatedDate.toISOString()}>
              <span class="i18n-en">{formatDate(updatedDate, 'en')}</span>
              <span class="i18n-zh">{formatDate(updatedDate, 'zh')}</span>
            </time>
          </span>
        )}
        <span class="reading-time">
          <span class="i18n-en">{formatReadingTime(readingTime, 'en')}</span>
          <span class="i18n-zh">{formatReadingTime(readingTime, 'zh')}</span>
        </span>
        <span class="word-count">
          <span class="i18n-en">{formatWords('en', wordCount)}</span>
          <span class="i18n-zh">{formatWords('zh', wordCount)}</span>
        </span>
        {language && <span class="post-language">{language}</span>}
      </p>

      {tags.length > 0 && (
        <ul class="article-tag-list">
          {tags.map((tag) => (
            <li>
              <a href={`${baseUrl}tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}>#{tag}</a>
            </li>
          ))}
        </ul>
      )}

      {showTOC && (
        <aside class="post-toc">
          <TOC headings={headings} />
        </aside>
      )}

      <div class="prose-custom">
        <slot />
      </div>
    </div>

    <footer class="post-nav">
      <PrevNext prev={prevPost} next={nextPost} />
    </footer>

    {relatedPosts.length > 0 && (
      <RelatedPosts posts={relatedPosts} />
    )}
  </article>
</NotesLayout>
